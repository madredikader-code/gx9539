local currentTrack = nil

-- دالة تشغيل الرقصات
local function PlayEmote(animId)
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    if currentTrack then
        currentTrack:Stop()
    end

    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. tostring(animId)
    
    pcall(function()
        currentTrack = animator:LoadAnimation(anim)
        currentTrack:Play()
        currentTrack.Looped = true
    end)
end

-- دالة تغيير المشيات
local function ApplyWalkpack(animId, animType)
    local character = LocalPlayer.Character
    if not character then return end
    
    local animateScript = character:FindFirstChild("Animate")
    if animateScript and animateScript:IsA("LocalScript") then
        local animString = (animType == "Run") and "run" or "walk"
        local animObj = animateScript:FindFirstChild(animString)
        if animObj then
            local animIdObj = animObj:FindFirstChildOfClass("Animation")
            if animIdObj then
                animIdObj.AnimationId = "rbxassetid://" .. tostring(animId)
            end
        end
    end
end

-- بناء العناصر في الواجهة (عناوين الأقسام وأزرار الأنشطة المستقلة)
for _, item in ipairs(masterList) do
    if item.Category then
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -10, 0, 30)
        lbl.BackgroundTransparency = 1
        lbl.Text = item.Category
        lbl.TextColor3 = Color3.fromRGB(0, 170, 255)
        lbl.TextSize = 13
        lbl.Font = Enum.Font.GothamBold
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = ScrollingFrame
    else
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, 36)
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
        btn.Text = item.Name
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 12
        btn.Font = Enum.Font.GothamMedium
        btn.Parent = ScrollingFrame

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 6)
        btnCorner.Parent = btn

        btn.MouseButton1Click:Connect(function()
            if item.Type == "Walk" or item.Type == "Run" then
                ApplyWalkpack(item.ID, item.Type)
            else
                PlayEmote(item.ID)
            end
        end)
    end
end

print("👑 تم تفعيل الأرشيف الشامل والمهووس للمشيات والرقصات داخل NOKS Hub بنجاح!")
