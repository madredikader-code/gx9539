-------------------------------------------------------------------------
-- برمجة الأحداث وتنقيب الألعاب
-------------------------------------------------------------------------

-- 1. زر قبول التحذير وتكبير الواجهة لكل الشاشة
EnterGameBtn.MouseButton1Click:Connect(function()
    WarningFrame.Visible = false
    FullscreenHub.Visible = true
end)

-- 2. إغلاق تحذير البداية
CloseWarnBtn.MouseButton1Click:Connect(function()
    WarningFrame.Visible = false
end)

-- 3. إغلاق الواجهة بالكامل
ExitFullBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

-- 4. التبديل للعبة الأولى (صيد الوحش)
Game1Btn.MouseButton1Click:Connect(function()
    Game1Container.Visible = true
    Game2Container.Visible = false
    Game1Btn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    Game2Btn.BackgroundColor3 = Color3.fromRGB(50, 30, 60)
end)

-- 5. التبديل للعبة الثانية (الزومبي والباركور)
Game2Btn.MouseButton1Click:Connect(function()
    Game1Container.Visible = false
    Game2Container.Visible = true
    Game2Btn.BackgroundColor3 = Color3.fromRGB(170, 0, 255)
    Game1Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
end)

-- منطق لعبة الوحش الأول (حركة عشوائية وضربات)
local hits = 0
Monster.MouseButton1Click:Connect(function()
    hits = hits + 1
    Score1.Text = "🎯 ضربات الوحش: " .. tostring(hits)
    local rx = math.random(10, 80) / 100
    local ry = math.random(20, 75) / 100
    Monster.Position = UDim2.new(rx, 0, ry, 0)
end)

-- حركة تلقائية للوحش كل ثانيتين
task.spawn(function()
    while true do
        if FullscreenHub.Visible and Game1Container.Visible then
            local rx = math.random(10, 80) / 100
            local ry = math.random(20, 75) / 100
            Monster.Position = UDim2.new(rx, 0, ry, 0)
        end
        task.wait(2)
    end
end)

-- منطق لعبة هروب الزومبي والباركور الثاتي
local survivalTime = 0
task.spawn(function()
    while true do
        if FullscreenHub.Visible and Game2Container.Visible then
            survivalTime = survivalTime + 1
            Score2.Text = "🧟‍♂️ صمود الباركور: " .. tostring(survivalTime) .. " ثواني"
            -- تحرك الزومبي وراء اللاعب تدريجياً
            local currentX = ZombieAvatar.Position.X.Scale
            if currentX < 0.8 then
                ZombieAvatar.Position = UDim2.new(currentX + 0.02, 0, 0.5, 0)
            else
                ZombieAvatar.Position = UDim2.new(0.05, 0, 0.5, 0) -- يرجع للبداية إذا مسكك
            end
        end
        task.wait(1)
    end
end)

print("👑 تم تفعيل نظام الألعاب الشامل (تغطية الشاشة + تحذير + لعبتين) تحت راية NOKS!")
